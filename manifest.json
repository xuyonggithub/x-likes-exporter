{
  "manifest_version": 3,
  "name": "X Likes to Markdown",
  "version": "0.2.0",
  "description": "把 X(Twitter) 上点赞的推文导出并增量追加到本地 Markdown 文件",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*/likes*",
        "https://twitter.com/*/likes*"
      ],
      "js": [
        "src/i18n/i18n.js",
        "src/content/app.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*/likes*",
        "https://twitter.com/*/likes*"
      ],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Likes to Markdown",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
